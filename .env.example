# Copy to .env and fill in. Never commit .env.

# Postgres (docker compose up -d gives you this)
DATABASE_URL=postgres://prospector:prospector@localhost:55433/prospector

# "fixtures" shows Lovable's design data; "live" reads the database. Production is always live.
DATA_MODE=live

# Claude
ANTHROPIC_API_KEY=

# Google sign-in and Gmail (OAuth client of type "Web application", Internal to your Workspace)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Comma-separated emails allowed to sign in
AUTH_ALLOWED_EMAILS=
# 32+ random bytes, base64. Signs sessions.
AUTH_SECRET=
# 32 random bytes, base64. Encrypts stored OAuth tokens.
TOKEN_ENCRYPTION_KEY=

# Register BOTH redirect URIs on the Google OAuth client:
#   <APP_URL>/auth/google/callback        (sign-in)
#   <APP_URL>/mailboxes/google/callback   (connecting Gmail mailboxes)
# Enable the Gmail API on the Google Cloud project.

# Only needed when the key is organisation-level rather than scoped to one workspace.
# Anthropic refuses such a key without it. Console > Settings > Workspaces.
# ANTHROPIC_WORKSPACE_ID=

# Claude model for agent roles
ANTHROPIC_MODEL=claude-haiku-4-5   # first-run default only; Settings decides thereafter

# Notifications: leave all unset to keep them in the app only. Slack wins if more than
# one is set. See docs/notifications.md for the three-minute Slack setup.
# NOTIFY_SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T000/B000/xxxxxxxx
# NOTIFY_NTFY_URL=https://ntfy.sh/your-private-topic
# NOTIFY_WEBHOOK_URL=https://example.com/hook

# Keys that may call /api/v1 (comma-separated, 16+ characters each)
API_KEYS=

# Public base URL, used for OAuth redirects
APP_URL=http://localhost:3000
