# The image installs its own dependencies and builds its own output; shipping the host's
# copies made the build context ~700MB and the build itself unusably slow.
node_modules
.output
.nitro
.vinxi
.vite
dist
build

# History, local state and test artefacts have no place in a runtime image.
.git
.github
test-results
playwright-report
coverage
*.log

# Secrets must never enter an image layer.
.env
.env.*
!.env.example

.DS_Store
